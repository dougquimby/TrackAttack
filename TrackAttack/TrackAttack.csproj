<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>TrackAttack</AssemblyName>
    <RootNamespace>TrackAttack</RootNamespace>
    <Version>1.1.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>TrackAttackLogo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BuildDateUtc</_Parameter1>
      <_Parameter2>$([System.DateTime]::UtcNow.ToString('yyyy-MM-dd', $([System.Globalization.CultureInfo]::GetCultureInfo('en-US'))))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Content Include="TrackAttackLogo.ico" />
    <Resource Include="Assets\SpotifyHelp\more-menu.png" />
    <Resource Include="Assets\SpotifyHelp\add-to-other-playlist.png" />
    <Resource Include="Assets\SpotifyHelp\new-playlist.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MetaBrainz.MusicBrainz" Version="8.0.1" />
    <PackageReference Include="MetaBrainz.MusicBrainz.CoverArt" Version="7.1.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="NAudio" Version="3.3.0" />
    <PackageReference Include="SpotifyAPI.Web" Version="7.4.2" />
    <PackageReference Include="SpotifyAPI.Web.Auth" Version="7.4.2" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>

</Project>
