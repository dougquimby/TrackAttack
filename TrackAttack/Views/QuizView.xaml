<UserControl x:Class="TrackAttack.Views.QuizView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" PreviewKeyDown="OnQuizPreviewKeyDown">
    <UserControl.Resources>
        <Style x:Key="QuizControlButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="82"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="{DynamicResource ButtonSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="QuizPowerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="40"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="MulliganButton" TargetType="Button" BasedOn="{StaticResource QuizPowerButton}">
            <Setter Property="Background" Value="{DynamicResource PowerMulliganSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PowerMulliganBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PowerMulliganTextBrush}"/>
        </Style>
        <Style x:Key="ExtenderButton" TargetType="Button" BasedOn="{StaticResource QuizPowerButton}">
            <Setter Property="Background" Value="{DynamicResource PowerExtenderSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PowerExtenderBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PowerExtenderTextBrush}"/>
        </Style>
        <Style x:Key="ClipRerollButton" TargetType="Button" BasedOn="{StaticResource QuizPowerButton}">
            <Setter Property="Background" Value="{DynamicResource PowerRerollSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PowerRerollBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PowerRerollTextBrush}"/>
        </Style>
        <Style x:Key="HintButton" TargetType="Button" BasedOn="{StaticResource QuizPowerButton}">
            <Setter Property="Background" Value="{DynamicResource PowerHintSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PowerHintBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PowerHintTextBrush}"/>
        </Style>
        <Style x:Key="QuizIconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Background" Value="#253248"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#43536B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="DangerQuizIconButton" TargetType="Button" BasedOn="{StaticResource QuizIconButton}">
            <Setter Property="Background" Value="#B42332"/>
            <Setter Property="BorderBrush" Value="#D14A57"/>
        </Style>
        <Style x:Key="QuizCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Visibility, ElementName=StarPowerBanner}" Value="Visible">
                    <Setter Property="Background" Value="{DynamicResource StarPowerSurfaceBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource StarPowerBorderBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid x:Name="StarPowerBackdrop" Grid.RowSpan="6" Visibility="Collapsed"
              IsHitTestVisible="False" ClipToBounds="True">
            <Border Background="{DynamicResource StarPowerBackdropBrush}" CornerRadius="8"/>
            <Border Opacity="0.18" CornerRadius="8">
                <Border.Background>
                    <DrawingBrush TileMode="Tile" Viewport="0,0,64,64" ViewportUnits="Absolute"
                                  Viewbox="0,0,64,64" ViewboxUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <GeometryDrawing Brush="{DynamicResource StarPowerPatternBrush}"
                                             Geometry="M 0,28 L 36,64 42,64 0,22 Z M 28,0 L 64,36 64,30 34,0 Z"/>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Border.Background>
            </Border>
        </Grid>
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="MuteButton" Content="&#xE767;" Style="{StaticResource QuizIconButton}"
                        Width="30" Height="30" Margin="0,0,8,0" FontFamily="Segoe MDL2 Assets" FontSize="15"
                        ToolTip="Mute audio" AutomationProperties.Name="Mute audio" Click="OnMuteClick"/>
                <TextBlock Text="Volume" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource MutedTextBrush}"/>
                <Slider x:Name="VolumeSlider" Minimum="0" Maximum="1" Value="1" Width="110"
                        IsMoveToPointEnabled="True"
                        VerticalAlignment="Center" ValueChanged="OnVolumeChanged"/>
            </StackPanel>
            <Button x:Name="QuizPauseButton" DockPanel.Dock="Right" Content="Ⅱ"
                    Style="{StaticResource QuizIconButton}" Margin="0,0,14,0"
                    ToolTip="Pause the entire quiz" AutomationProperties.Name="Pause the entire quiz"
                    Click="OnQuizPauseClick"/>
            <TextBlock x:Name="TimerText" DockPanel.Dock="Right" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource AccentStrongTextBrush}" Margin="0,0,24,0"/>
            <TextBlock x:Name="ScoreText" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
        </DockPanel>
        <Border Grid.Row="1" Style="{StaticResource QuizCard}" BorderThickness="1" CornerRadius="8" Padding="18">
            <StackPanel>
                <TextBlock x:Name="NowPlayingText" Text="Starting…" FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource StrongTextBrush}"/>
                <Grid Margin="0,6,0,0" Height="30">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border x:Name="StreakIndicator" Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}"
                            BorderThickness="1" CornerRadius="5" Padding="9,0" Margin="0,0,8,0" Height="30">
                        <TextBlock x:Name="StreakText" Text="STREAK  0" FontWeight="Bold"
                                   Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"
                                   AutomationProperties.LiveSetting="Polite"/>
                    </Border>
                    <Border x:Name="StarPowerBanner" Grid.Column="1" Visibility="Collapsed"
                            Background="{DynamicResource StarPowerBannerBrush}" BorderBrush="{DynamicResource StarPowerBorderBrush}"
                            BorderThickness="1" CornerRadius="5" Padding="9,0" Height="30" HorizontalAlignment="Left">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="StarPowerIcon" Text="★" FontSize="15" FontWeight="Bold"
                                       Foreground="{DynamicResource StarPowerTextBrush}" RenderTransformOrigin="0.5,0.5"
                                       VerticalAlignment="Center" Margin="0,0,6,0">
                                <TextBlock.RenderTransform><RotateTransform x:Name="StarPowerRotation"/></TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock x:Name="StarPowerText" Grid.Column="1" FontSize="12" FontWeight="Bold"
                                       Foreground="{DynamicResource StarPowerTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       AutomationProperties.LiveSetting="Polite"/>
                            <TextBlock Grid.Column="2" Text=" ✦" FontSize="14" Foreground="{DynamicResource StarPowerTextBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
                <TextBlock x:Name="PlaybackStatusText" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"
                           TextWrapping="Wrap" Visibility="Collapsed"/>
                <Grid Margin="0,8,0,2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid x:Name="ClipProgress" Height="14" VerticalAlignment="Center" Background="{DynamicResource ProgressTrackBrush}"
                          ClipToBounds="True" Cursor="Hand" MouseLeftButtonDown="OnClipProgressClick"
                          ToolTip="Click to seek within the current clip">
                        <Border x:Name="ClipProgressFill" HorizontalAlignment="Left" Background="#17803D"/>
                    </Grid>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                        <Button x:Name="ClipPauseButton" Content="Ⅱ" Style="{StaticResource QuizIconButton}"
                                ToolTip="Pause only the song clip" AutomationProperties.Name="Pause only the song clip" Click="OnClipPauseClick"/>
                        <Button Content="↻" Style="{StaticResource QuizIconButton}"
                                ToolTip="Replay clip" AutomationProperties.Name="Replay clip" Click="OnReplayClick"/>
                        <Button Content="››" Style="{StaticResource QuizIconButton}"
                                ToolTip="Pass this song" AutomationProperties.Name="Pass this song" Click="OnPassClick"/>
                        <Button Content="■" Style="{StaticResource DangerQuizIconButton}" Margin="6,0,0,0"
                                ToolTip="End quiz" AutomationProperties.Name="End quiz" Click="OnEndClick"/>
                    </StackPanel>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="SongTimeText" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="ClipTimeText" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Right"/>
                </Grid>
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource QuizCard}" BorderThickness="1" CornerRadius="8"
                Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="YOUR ANSWER" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}"
                           VerticalAlignment="Center" Margin="0,0,14,0"/>
                <TextBox x:Name="AnswerText" Grid.Column="1" Height="36" FontSize="17" Padding="10,4"
                         VerticalContentAlignment="Center" KeyDown="OnAnswerKeyDown" TextChanged="OnAnswerTextChanged"
                         SpellCheck.IsEnabled="True"/>
                <Grid Grid.Column="2" Margin="14,0,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock x:Name="AnswerPrompt" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="FeedbackText" Grid.Row="1" Foreground="{DynamicResource AccentStrongTextBrush}" FontSize="15"
                               FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,0"/>
                </Grid>
                <Border x:Name="PowerGroupPanel" Grid.Column="3" Background="{DynamicResource SubtleSurfaceBrush}"
                        BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="6"
                        Padding="4" Margin="12,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="MulliganButton" Style="{StaticResource MulliganButton}"
                                ToolTip="Replace the current song" AutomationProperties.Name="Use mulligan power"
                                Click="OnMulliganClick">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="↻" FontSize="17" VerticalAlignment="Center"/>
                                <TextBlock x:Name="MulliganCountText" FontFamily="Segoe UI" FontSize="11"
                                           FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,1,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ExtenderButton" Style="{StaticResource ExtenderButton}"
                                ToolTip="Extend the current song clip" AutomationProperties.Name="Use extender power"
                                Click="OnExtenderClick">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⏱" FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ExtenderCountText" FontFamily="Segoe UI" FontSize="11"
                                           FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,1,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ClipRerollButton" Style="{StaticResource ClipRerollButton}"
                                ToolTip="Choose a new random clip start" AutomationProperties.Name="Reroll clip start"
                                Click="OnClipRerollClick">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🎲" FontFamily="Segoe UI Emoji" FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ClipRerollCountText" FontFamily="Segoe UI" FontSize="11"
                                           FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,1,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="HintButton" Style="{StaticResource HintButton}" Margin="0"
                                ToolTip="Reveal a hint for the current song" AutomationProperties.Name="Use hint power"
                                Click="OnHintClick">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="?" FontFamily="Segoe UI" FontSize="15" FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="HintCountText" FontFamily="Segoe UI" FontSize="11"
                                           FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,1,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <Border Grid.Row="3" Style="{StaticResource QuizCard}" BorderThickness="1"
                CornerRadius="8" Padding="10">
            <DataGrid x:Name="SongsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      SelectionMode="Single" SelectionUnit="Cell" HeadersVisibility="Column"
                      PreviewMouseLeftButtonDown="OnSongGridMouseDown"
                      FontSize="13" RowHeight="29" ColumnHeaderHeight="34" BorderThickness="0"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
        </Border>
        <Border Grid.Row="4" Style="{StaticResource QuizCard}" BorderThickness="1"
                CornerRadius="8" Padding="14,10" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="HINTS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,8,0"/>
                <ScrollViewer Grid.Column="1" MaxHeight="150" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="HintsList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource HintSurfaceBrush}" CornerRadius="4" Padding="9,5" Margin="0,0,7,5">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayText}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                        <Button Padding="0" BorderThickness="0" Background="Transparent" Margin="0,6,0,0"
                                                HorizontalAlignment="Left" ToolTip="Click to enlarge album cover"
                                                AutomationProperties.Name="Enlarge album cover" Click="OnEnlargeCoverClick">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Artwork}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Image Source="{Binding Artwork}" Width="128" Height="128" Stretch="Uniform"/>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
        <TextBlock Grid.Row="5" Text="Ctrl+P passes · Ctrl+R replays · Ctrl+Space pauses the clip · Ctrl+Shift+Space pauses the quiz · Tab passes"
                   Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,8,0,0"/>
    </Grid>
</UserControl>
