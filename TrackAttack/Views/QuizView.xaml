<UserControl x:Class="TrackAttack.Views.QuizView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" PreviewKeyDown="OnQuizPreviewKeyDown">
    <UserControl.Resources>
        <Style x:Key="QuizControlButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="82"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="#E7EDF5"/>
            <Setter Property="Foreground" Value="#253248"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="MulliganButton" TargetType="Button" BasedOn="{StaticResource QuizControlButton}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="#604878"/>
            <Setter Property="BorderBrush" Value="#80649A"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="ExtenderButton" TargetType="Button" BasedOn="{StaticResource QuizControlButton}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="#3D6843"/>
            <Setter Property="BorderBrush" Value="#628469"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="HintButton" TargetType="Button" BasedOn="{StaticResource QuizControlButton}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Background" Value="#286583"/>
            <Setter Property="BorderBrush" Value="#4C849F"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="QuizIconButton" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Background" Value="#253248"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#43536B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="DangerQuizIconButton" TargetType="Button" BasedOn="{StaticResource QuizIconButton}">
            <Setter Property="Background" Value="#B42332"/>
            <Setter Property="BorderBrush" Value="#D14A57"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Volume" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#65738A"/>
                <Slider x:Name="VolumeSlider" Minimum="0" Maximum="1" Value="1" Width="110"
                        VerticalAlignment="Center" ValueChanged="OnVolumeChanged"/>
            </StackPanel>
            <Button x:Name="QuizPauseButton" DockPanel.Dock="Right" Content="Ⅱ"
                    Style="{StaticResource QuizIconButton}" Margin="0,0,14,0"
                    ToolTip="Pause the entire quiz" AutomationProperties.Name="Pause the entire quiz"
                    Click="OnQuizPauseClick"/>
            <TextBlock x:Name="TimerText" DockPanel.Dock="Right" FontSize="26" FontWeight="Bold" Foreground="#1769AA" Margin="0,0,24,0"/>
            <TextBlock x:Name="ScoreText" FontSize="18" FontWeight="SemiBold" Foreground="#253248"/>
        </DockPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="#E0E5EC" BorderThickness="1" CornerRadius="6" Padding="16">
            <StackPanel>
                <TextBlock x:Name="NowPlayingText" Text="Starting…" FontSize="18" FontWeight="SemiBold"
                           Foreground="#172338"/>
                <TextBlock x:Name="PlaybackStatusText" Foreground="#65738A" FontSize="11"
                           TextWrapping="Wrap" Visibility="Collapsed"/>
                <Grid Margin="0,8,0,2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid x:Name="ClipProgress" Height="14" VerticalAlignment="Center" Background="#E2E8F0"
                          ClipToBounds="True" Cursor="Hand" MouseLeftButtonDown="OnClipProgressClick"
                          ToolTip="Click to seek within the current clip">
                        <Border x:Name="ClipProgressFill" HorizontalAlignment="Left" Background="#17803D"/>
                    </Grid>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                        <Button x:Name="ClipPauseButton" Content="Ⅱ" Style="{StaticResource QuizIconButton}"
                                ToolTip="Pause only the song clip" AutomationProperties.Name="Pause only the song clip" Click="OnClipPauseClick"/>
                        <Button Content="↻" Style="{StaticResource QuizIconButton}"
                                ToolTip="Replay clip" AutomationProperties.Name="Replay clip" Click="OnReplayClick"/>
                        <Button Content="››" Style="{StaticResource QuizIconButton}"
                                ToolTip="Pass this song" AutomationProperties.Name="Pass this song" Click="OnPassClick"/>
                        <Button Content="■" Style="{StaticResource DangerQuizIconButton}" Margin="6,0,0,0"
                                ToolTip="End quiz" AutomationProperties.Name="End quiz" Click="OnEndClick"/>
                    </StackPanel>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="SongTimeText" Foreground="#65738A" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="ClipTimeText" Grid.Column="1" Foreground="#65738A" HorizontalAlignment="Right"/>
                </Grid>
            </StackPanel>
        </Border>
        <Border x:Name="PowerGroupPanel" Grid.Row="2" Background="#253248" CornerRadius="5"
                Padding="10,4" Margin="0,8,0,10" HorizontalAlignment="Left" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="POWERS" Foreground="#C5D2E3" FontSize="10" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button x:Name="MulliganButton" Content="Mulligan" Style="{StaticResource MulliganButton}" Click="OnMulliganClick"/>
                    <Button x:Name="ExtenderButton" Content="Extender" Style="{StaticResource ExtenderButton}" Click="OnExtenderClick"/>
                    <Button x:Name="HintButton" Content="Hint" Style="{StaticResource HintButton}" Margin="0" Click="OnHintClick"/>
                </StackPanel>
        </Border>
        <Border Grid.Row="3" Background="White" BorderBrush="#D5DCE5" BorderThickness="1" CornerRadius="6"
                Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="YOUR ANSWER" FontSize="12" FontWeight="Bold" Foreground="#65738A"
                           VerticalAlignment="Center" Margin="0,0,14,0"/>
                <TextBox x:Name="AnswerText" Grid.Column="1" Height="36" FontSize="17" Padding="10,4"
                     VerticalContentAlignment="Center" KeyDown="OnAnswerKeyDown" TextChanged="OnAnswerTextChanged"
                     SpellCheck.IsEnabled="True"/>
                <Grid Grid.Column="2" Margin="16,0,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock x:Name="AnswerPrompt" Foreground="#65738A" TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="FeedbackText" Grid.Row="1" Foreground="#1769AA" FontSize="15"
                               FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,0"/>
                </Grid>
            </Grid>
        </Border>
        <Border Grid.Row="4" Background="White" BorderBrush="#D5DCE5" BorderThickness="1"
                CornerRadius="6" Padding="8">
            <DataGrid x:Name="SongsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      SelectionMode="Single" SelectionUnit="Cell" HeadersVisibility="Column"
                      PreviewMouseLeftButtonDown="OnSongGridMouseDown"
                      FontSize="13" RowHeight="29" ColumnHeaderHeight="34" BorderThickness="0"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
        </Border>
        <Border Grid.Row="5" Background="White" BorderBrush="#D5DCE5" BorderThickness="1"
                CornerRadius="6" Padding="12,8" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="HINTS" FontSize="11" FontWeight="Bold" Foreground="#65738A" Margin="0,3,8,0"/>
                <ScrollViewer Grid.Column="1" MaxHeight="76" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="HintsList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#EEF3FA" CornerRadius="4" Padding="9,5" Margin="0,0,7,5">
                                    <TextBlock Text="{Binding}" Foreground="#34445C" TextWrapping="Wrap"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
        <TextBlock Grid.Row="6" Text="Ctrl+P passes · Ctrl+R replays · Ctrl+Space pauses the clip · Ctrl+Shift+Space pauses the quiz · Tab passes"
                   Foreground="#65738A" FontSize="11" Margin="0,8,0,0"/>
    </Grid>
</UserControl>
