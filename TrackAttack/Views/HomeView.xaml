<UserControl x:Class="TrackAttack.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Welcome to Track Attack" Style="{StaticResource PageTitle}" FontSize="32"/>
            <TextBlock Text="Play a quiz from your local music library, review previous results, or clean up track metadata."
                       FontSize="16" Foreground="#65738A" TextWrapping="Wrap" Margin="0,0,0,28"/>
            <UniformGrid Columns="2" Rows="2">
                <Button Content="Start a New Quiz" Style="{StaticResource ActionButton}" Height="90" FontSize="18"
                        Click="OnNewQuizClick"/>
                <Button Content="Fix Library Metadata" Style="{StaticResource ActionButton}" Height="90" FontSize="18"
                        Click="OnMetadataClick"/>
                <Button Content="Quiz History" Style="{StaticResource ActionButton}" Height="90" FontSize="18"
                        Click="OnHistoryClick"/>
                <Button Content="Settings" Style="{StaticResource ActionButton}" Height="90" FontSize="18"
                        Click="OnSettingsClick"/>
            </UniformGrid>
            <Border Background="White" BorderBrush="#E0E5EC" BorderThickness="1" CornerRadius="6"
                    Padding="18" Margin="4,28,4,0">
                <StackPanel>
                    <TextBlock Text="Most recent quiz" FontSize="17" FontWeight="SemiBold" Foreground="#253248"/>
                    <TextBlock x:Name="LastQuizText" Text="Quiz history will appear here after your first game."
                               Margin="0,8,0,0" Foreground="#65738A" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
