<UserControl x:Class="TrackAttack.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="HomeActionCard" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#172338"/>
            <Setter Property="BorderBrush" Value="#DCE4EF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Height" Value="104"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1000" HorizontalAlignment="Left">
            <Border Background="#1B2638" CornerRadius="10" Padding="30" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="190"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" MaxWidth="620" Margin="0,0,12,0">
                        <TextBlock Text="TRACK ATTACK  /  MUSIC QUIZ" Foreground="#72BFFF"
                                   FontSize="11" FontWeight="Bold" Margin="0,0,0,12"/>
                        <TextBlock Text="Ready to name that track?" Foreground="White"
                                   FontSize="32" FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBlock Text="Build a quiz from your library, trust your ears, and climb the leaderboard."
                                   Foreground="#C5D2E3" FontSize="15" TextWrapping="Wrap"
                                   Margin="0,10,12,22"/>
                        <Button Content="START A NEW QUIZ    ›" Click="OnNewQuizClick"
                                HorizontalAlignment="Left" Padding="20,12"
                                Background="#1677C8" Foreground="White" BorderThickness="0"
                                FontSize="14" FontWeight="Bold" Cursor="Hand"/>
                    </StackPanel>
                    <Grid Grid.Column="1" Width="160" Height="160"
                          VerticalAlignment="Center" Opacity="0.9">
                        <Ellipse Fill="#253248" Stroke="#3E91D2" StrokeThickness="3"/>
                        <Ellipse Margin="15" Stroke="#52718F" StrokeThickness="2"/>
                        <Ellipse Margin="34" Stroke="#3E91D2" StrokeThickness="2"/>
                        <Ellipse Margin="54" Stroke="#52718F" StrokeThickness="2"/>
                        <Ellipse Width="18" Height="18" Fill="#F5A623"/>
                        <Path Data="M 115,20 L 85,96 L 108,96 L 91,171 L 143,79 L 119,79 L 139,20 Z"
                              Fill="#F5A623" Stroke="#1B2638" StrokeThickness="4"
                              Stretch="Fill" Width="62" Height="152"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="YOUR CONTROL ROOM" Foreground="#253248"
                               FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="Manage your library and review your progress."
                               Foreground="#65738A" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="PLAYING AS" Foreground="#65738A" FontSize="10"
                               FontWeight="Bold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="ProfileCombo" Width="190" Height="30"
                              SelectionChanged="OnProfileSelectionChanged"/>
                </StackPanel>
            </Grid>

            <UniformGrid Columns="3" Rows="1" Margin="0,0,0,8">
                <Button Style="{StaticResource HomeActionCard}" Click="OnMetadataClick">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="✎  LIBRARY TOOLS" Foreground="#1677C8"
                                   FontSize="10" FontWeight="Bold"/>
                        <TextBlock Text="Fix library metadata" FontSize="16" FontWeight="SemiBold"
                                   Margin="0,8,0,0"/>
                        <TextBlock Text="Clean up track details" Foreground="#65738A" FontSize="12"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource HomeActionCard}" Click="OnHistoryClick">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="◷  YOUR RECORD" Foreground="#1677C8"
                                   FontSize="10" FontWeight="Bold"/>
                        <TextBlock Text="Quiz history" FontSize="16" FontWeight="SemiBold"
                                   Margin="0,8,0,0"/>
                        <TextBlock Text="Scores and past rounds" Foreground="#65738A" FontSize="12"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource HomeActionCard}" Margin="0,0,0,12" Click="OnSettingsClick">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="⚙  PREFERENCES" Foreground="#1677C8"
                                   FontSize="10" FontWeight="Bold"/>
                        <TextBlock Text="Settings" FontSize="16" FontWeight="SemiBold"
                                   Margin="0,8,0,0"/>
                        <TextBlock Text="Tune your experience" Foreground="#65738A" FontSize="12"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </Button>
            </UniformGrid>

            <Button Background="Transparent" BorderThickness="0" Padding="0"
                    HorizontalContentAlignment="Stretch" Cursor="Hand"
                    AutomationProperties.Name="Open quiz history" Click="OnHistoryClick">
                <Border Background="White" BorderBrush="#DCE4EF" BorderThickness="1"
                        CornerRadius="8" Padding="20" Margin="0,10,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" CornerRadius="21" Background="#EAF4FD"
                                VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock Text="♫" Foreground="#1677C8" FontSize="22"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="RECENT SESSION" Foreground="#8290A3"
                                       FontSize="10" FontWeight="Bold"/>
                            <TextBlock x:Name="LastQuizText" Text="Your quiz history will appear here after your first game."
                                       Foreground="#253248" FontSize="14" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="LATEST" Foreground="#1677C8"
                                   FontSize="10" FontWeight="Bold" VerticalAlignment="Center"
                                   Margin="16,0,0,0"/>
                    </Grid>
                </Border>
            </Button>
        </StackPanel>
    </ScrollViewer>
</UserControl>
