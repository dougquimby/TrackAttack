<UserControl x:Class="TrackAttack.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel>
            <Button x:Name="ClearHistoryButton" Content="Clear history…" DockPanel.Dock="Right" Height="36" Padding="12,5"
                    Margin="0,0,4,16" Click="OnClearHistoryClick"/>
            <TextBlock Text="Quiz History" Style="{StaticResource PageTitle}"/>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="4*"/></Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="COMPLETED QUIZZES" FontSize="12" FontWeight="Bold"
                           Foreground="#65738A" Margin="0,0,0,10"/>
                <DataGrid x:Name="HistoryGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" SelectionChanged="OnSelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="36" CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Width="22" Height="22" ToolTip="{Binding SourceLabel}"
                                          AutomationProperties.Name="{Binding SourceLabel}">
                                        <Grid x:Name="LocalSourceIcon">
                                            <Ellipse Fill="#1677C8"/>
                                            <Ellipse Margin="5" Stroke="White" StrokeThickness="1.5"/>
                                            <Ellipse Width="4" Height="4" Fill="White"/>
                                        </Grid>
                                        <Grid x:Name="SpotifySourceIcon" Visibility="Collapsed">
                                            <Ellipse Fill="#1DB954"/>
                                            <Path Data="M 4,8 C 9,6 15,7 19,9 M 5,11 C 9,10 14,10.5 18,12.5 M 6,14 C 10,13 13,13.5 16,15"
                                                  Stroke="White" StrokeThickness="1.4" StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round" Fill="Transparent"/>
                                        </Grid>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSpotify}" Value="True">
                                            <Setter TargetName="LocalSourceIcon" Property="Visibility" Value="Collapsed"/>
                                            <Setter TargetName="SpotifySourceIcon" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Date" Binding="{Binding DateLabel}" Width="*"/>
                        <DataGridTextColumn Header="Quiz" Binding="{Binding Title}" Width="*"/>
                        <DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="100"/>
                        <DataGridTextColumn Header="%" Binding="{Binding Percentage}" Width="60"/>
                        <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="DetailHeading" Text="Select a quiz to review its answers" FontSize="12"
                           Foreground="#65738A" FontWeight="Bold" Margin="0,0,0,10" TextTrimming="CharacterEllipsis"/>
                <DataGrid x:Name="DetailGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Correct">
                                    <Setter Property="Background" Value="#E1F2E8"/>
                                    <Setter Property="Foreground" Value="#245B38"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Partial">
                                    <Setter Property="Background" Value="#FFF2D6"/>
                                    <Setter Property="Foreground" Value="#74520A"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Missed">
                                    <Setter Property="Background" Value="#FCE6E8"/>
                                    <Setter Property="Foreground" Value="#8A3540"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="40"/>
                        <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
                        <DataGridTextColumn Header="Artist" Binding="{Binding Artist}" Width="*"/>
                        <DataGridTextColumn Header="Title guess" Binding="{Binding Guess}" Width="*"/>
                        <DataGridTextColumn Header="Artist guess" Binding="{Binding ArtistGuess}" Width="*"/>
                        <DataGridTextColumn Header="Points" Binding="{Binding Points}" Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Border Grid.Row="2" Background="#F4F6FA" BorderBrush="#DCE4EF" BorderThickness="1"
                        CornerRadius="8" Padding="12" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="SCORE-IMPACTING SETTINGS" FontSize="11" FontWeight="Bold"
                                   Foreground="#65738A" Margin="0,0,0,5"/>
                        <TextBlock x:Name="SettingsSummaryText" Text="Select a quiz to see its settings and power usage."
                                   Foreground="#34445C" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
