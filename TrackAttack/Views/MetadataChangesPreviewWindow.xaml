<Window x:Class="TrackAttack.Views.MetadataChangesPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review metadata changes" Width="1050" Height="650" MinWidth="680" MinHeight="400"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
    <Window.Resources>
        <Style x:Key="PreviewCellText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="4,2"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="SummaryText" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <TextBlock Grid.Row="1" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="Review all staged changes, including tracks not currently selected or visible. Before values are from the last scan; rescan if files have changed externally."/>
        <DataGrid x:Name="ChangesGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="True"
                  HeadersVisibility="Column" SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="File path" Binding="{Binding FilePath}" Width="2*"
                                    ElementStyle="{StaticResource PreviewCellText}"/>
                <DataGridTextColumn Header="Field" Binding="{Binding Field}" Width="120"
                                    ElementStyle="{StaticResource PreviewCellText}"/>
                <DataGridTextColumn Header="Before (at scan)" Binding="{Binding Before}" Width="1.5*"
                                    ElementStyle="{StaticResource PreviewCellText}"/>
                <DataGridTextColumn Header="After" Binding="{Binding After}" Width="1.5*"
                                    ElementStyle="{StaticResource PreviewCellText}"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="3" Margin="0,10,0,12" TextWrapping="Wrap"
                   Text="(empty) indicates a blank or absent value. Artist edits update track performers, not album artist. A recovery snapshot is created before writing."/>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Apply changes" Click="OnApplyClick" Margin="0,0,8,0"/>
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
