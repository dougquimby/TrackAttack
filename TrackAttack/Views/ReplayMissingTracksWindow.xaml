<Window x:Class="TrackAttack.Views.ReplayMissingTracksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tracks unavailable" Width="560" SizeToContent="Height"
        MinWidth="450" MaxHeight="600" WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip" Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="SummaryText" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <ScrollViewer Grid.Row="1" MaxHeight="180" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="TracksText" TextWrapping="Wrap"/>
        </ScrollViewer>
        <TextBlock x:Name="ReplacementText" Grid.Row="2" TextWrapping="Wrap" Margin="0,12,0,14"/>
        <WrapPanel Grid.Row="3" HorizontalAlignment="Right">
            <Button x:Name="RemainingButton" Content="Play remaining" Click="OnRemainingClick" Margin="0,0,6,0"/>
            <Button x:Name="ReplaceButton" Content="Replace missing" Click="OnReplaceClick" Margin="0,0,6,0"/>
            <Button Content="Cancel" IsCancel="True"/>
        </WrapPanel>
    </Grid>
</Window>
