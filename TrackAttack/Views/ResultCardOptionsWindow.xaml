<Window x:Class="TrackAttack.Views.ResultCardOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save result card" Width="560" Height="570" MinWidth="460" MinHeight="460"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="Choose what to include" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="The score, profile, quiz name, mode, track count, time, and date are always included."
                           TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,6,0,18"/>
                <TextBlock Text="TRACKS" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6"/>
                <RadioButton x:Name="NoTracksRadio" GroupName="Tracks" Content="Summary only" IsChecked="True"
                             Checked="OnTrackSelectionChanged" Margin="0,4"/>
                <RadioButton x:Name="AllTracksRadio" GroupName="Tracks" Content="All tracks, including mulligans"
                             Checked="OnTrackSelectionChanged" Margin="0,4"/>
                <RadioButton x:Name="PointsTracksRadio" GroupName="Tracks" Content="Only tracks that earned points after penalties"
                             Checked="OnTrackSelectionChanged" Margin="0,4"/>
                <CheckBox x:Name="GuessesCheck" Content="Include recorded guesses" IsEnabled="False" Margin="22,10,0,0"/>
                <TextBlock Text="Only accepted guesses are recorded; incorrect guesses are not available."
                           Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="22,4,0,18"/>
                <TextBlock Text="EXTRAS" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6"/>
                <CheckBox x:Name="SettingsCheck" Content="Include quiz settings" Margin="0,4"/>
                <CheckBox x:Name="RankCheck" Content="Include leaderboard position" Margin="0,4"/>
                <TextBlock Text="Leaderboard position uses comparable attempts saved on this computer."
                           Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="22,4,0,12"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0"/>
            <Button x:Name="SaveButton" Content="Save PNG…" Style="{StaticResource ActionButton}"
                    BorderThickness="1" BorderBrush="Transparent" Margin="0" Click="OnSaveClick"/>
        </StackPanel>
    </Grid>
</Window>
