<UserControl x:Class="TrackAttack.Views.ResultCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="1200" Height="630" FontFamily="Segoe UI">
    <StackPanel Background="#142033">
    <Grid Background="#142033" ClipToBounds="True" Height="630">
        <Ellipse Width="490" Height="490" Stroke="#1F4161" StrokeThickness="2"
                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-190,-120,0"/>
        <Ellipse Width="390" Height="390" Stroke="#1F4161" StrokeThickness="2"
                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-140,-70,0"/>
        <Grid Margin="60,46">
            <Grid.RowDefinitions>
                <RowDefinition Height="80"/>
                <RowDefinition Height="112"/>
                <RowDefinition Height="230"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <Grid Width="52" Height="52" Margin="0,0,16,0">
                    <Ellipse Stroke="#68B7FF" StrokeThickness="2" Fill="#253248"/>
                    <Ellipse Width="30" Height="30" Stroke="#68B7FF" StrokeThickness="1.5"/>
                    <Ellipse Width="7" Height="7" Fill="#F5A623"/>
                    <Path Data="M 26,5 L 17,21 L 23,21 L 18,39 L 31,18 L 25,18 L 30,5 Z"
                          Fill="#F5A623" Stroke="#142033" StrokeThickness="1"
                          Stretch="Fill" Width="18" Height="34"/>
                </Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="TRACK ATTACK" Foreground="White" FontSize="26" FontWeight="Bold"/>
                    <TextBlock Text="MUSIC QUIZ" Foreground="#A9BED7" FontSize="12" FontWeight="SemiBold"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Row="1">
                <TextBlock Text="QUIZ RESULTS" Foreground="#68B7FF" FontSize="15" FontWeight="Bold"/>
                <TextBlock x:Name="TitleText" Foreground="White" FontSize="38" FontWeight="Bold"
                           TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
            </StackPanel>
            <Border Grid.Row="2" Background="#253A54" CornerRadius="14" Padding="30,22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="430"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SCORE" Foreground="#A9BED7" FontSize="15" FontWeight="Bold"/>
                        <TextBlock x:Name="PercentageText" Foreground="#68B7FF" FontSize="76"
                                   FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="ScoreText" Foreground="White" FontSize="23"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Grid Grid.Column="1" Margin="26,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Text="PLAYER" Foreground="#A9BED7" FontSize="13" FontWeight="Bold"/>
                            <TextBlock x:Name="ProfileText" Foreground="White" FontSize="22" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="MODE" Foreground="#A9BED7" FontSize="13" FontWeight="Bold"/>
                            <TextBlock x:Name="ModeText" Foreground="White" FontSize="22" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,0,20,0">
                            <TextBlock Text="TRACKS" Foreground="#A9BED7" FontSize="13" FontWeight="Bold"/>
                            <TextBlock x:Name="TracksText" Foreground="White" FontSize="22" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1">
                            <TextBlock Text="TIME" Foreground="#A9BED7" FontSize="13" FontWeight="Bold"/>
                            <TextBlock x:Name="DurationText" Foreground="White" FontSize="22" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <TextBlock x:Name="DateText" Grid.Row="3" VerticalAlignment="Bottom"
                       Foreground="#A9BED7" FontSize="16"/>
        </Grid>
    </Grid>
    <StackPanel x:Name="DetailsPanel" Visibility="Collapsed" Margin="60,0,60,46"/>
    </StackPanel>
</UserControl>
