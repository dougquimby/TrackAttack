<UserControl x:Class="TrackAttack.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Active profile" VerticalAlignment="Center" Margin="4,0,10,0"/>
                <ComboBox x:Name="ProfileCombo" Grid.Column="1" Height="32" MaxWidth="300"
                          HorizontalAlignment="Left" MinWidth="220"
                          DisplayMemberPath="Name" SelectionChanged="OnProfileSelectionChanged"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,5,0,0" FontSize="11"
                           Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                           Text="Changing profiles saves the current profile's library folders and appearance."/>
            </Grid>
        </Border>
        <TabControl x:Name="SettingsTabs" Grid.Row="1" Margin="0,0,0,8">
            <TabItem Header="Profiles">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="8">
                    <StackPanel>
                    <TextBlock Text="QUIZ PROFILES" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}"/>
                    <TextBlock Text="Profile name" Margin="0,8,0,4"/>
                    <DockPanel Margin="0,0,0,18" LastChildFill="False">
                        <TextBox x:Name="ProfileNameText" Height="32" Width="220"
                                 VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                        <Button Content="Add" Padding="12,5" Margin="0,0,6,0" Click="OnAddProfileClick"/>
                        <Button Content="Rename" Padding="12,5" Margin="0,0,6,0" Click="OnRenameProfileClick"/>
                        <Button Content="Delete" Padding="12,5" Click="OnDeleteProfileClick"/>
                    </DockPanel>
                    <TextBlock Text="PROFILE ICON" FontSize="12" FontWeight="Bold"
                               Foreground="{DynamicResource MutedTextBrush}"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,18">
                        <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource IconSurfaceBrush}"
                                Margin="0,0,12,0">
                            <Grid>
                                <TextBlock x:Name="ProfileIconInitials" Foreground="{DynamicResource AccentTextBrush}"
                                           FontSize="14" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image x:Name="ProfileIconPreview" Stretch="UniformToFill"
                                       Visibility="Collapsed">
                                    <Image.Clip>
                                        <EllipseGeometry Center="22,22" RadiusX="22" RadiusY="22"/>
                                    </Image.Clip>
                                </Image>
                            </Grid>
                        </Border>
                        <Button Content="Choose image…" Padding="12,5" Margin="0,0,6,0"
                                ToolTip="PNG, JPEG, or BMP images are saved as PNG and resized to fit a 256-pixel icon."
                                Click="OnChooseProfileIconClick"/>
                        <Button x:Name="RemoveProfileIconButton" Content="Remove" Padding="12,5"
                                Click="OnRemoveProfileIconClick"/>
                    </StackPanel>
                    <TextBlock Text="PROFILE AUDIO VOLUME" FontSize="12" FontWeight="Bold"
                               Foreground="{DynamicResource MutedTextBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Slider x:Name="AudioVolumeSlider" Minimum="0" Maximum="1"
                                SmallChange="0.01" LargeChange="0.1" Value="1"
                                Width="240" IsMoveToPointEnabled="True"
                                ValueChanged="OnAudioVolumeChanged"/>
                        <TextBlock x:Name="AudioVolumeValueText" Margin="8,0,0,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"/>
                    </StackPanel>
                    </StackPanel>
                </Border>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Music library">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="MUSIC LIBRARY" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}"/>
                                <TextBlock Grid.Row="1" Text="Add the folders containing your music. Choose subfolders for each quiz in quiz setup."
                                           Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <Grid Grid.Row="2" Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ListBox x:Name="MusicFoldersList" MinHeight="120"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <Button Content="Add folder…" Click="OnAddMusicFolderClick" Margin="0,0,0,6"/>
                                        <Button Content="Remove" Click="OnRemoveMusicFolderClick" Margin="0,0,0,6"/>
                                        <Button x:Name="RemoveMissingFoldersButton" Content="Remove missing…"
                                                Click="OnRemoveMissingMusicFoldersClick"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Grid.Row="3" Margin="0,18,0,0">
                                    <TextBlock Text="LIBRARY TOOLS" FontSize="12" FontWeight="Bold"
                                               Foreground="{DynamicResource MutedTextBrush}"/>
                                    <TextBlock Text="Review and repair missing or incorrect track metadata."
                                               Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    <Button Content="Fix library metadata…" HorizontalAlignment="Left"
                                            Margin="0,8,0,0" Click="OnMetadataClick"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Appearance">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="18" Margin="8">
                        <StackPanel>
                            <TextBlock Text="APPEARANCE" FontSize="12" FontWeight="Bold"
                                       Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,10"/>
                            <CheckBox x:Name="DarkModeCheck" Content="Enable dark mode"/>
                            <TextBlock Text="The theme is saved for this profile and changes throughout Track Attack when you save Settings or switch profiles."
                                       Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            <CheckBox x:Name="ShowCountsCheck" Content="Show track counts in genre and decade filters" Margin="0,18,0,0"/>
                            <CheckBox x:Name="ShowRecordCelebrationsCheck" Content="Show personal-best and record celebrations after quizzes" Margin="0,10,0,0"/>
                            <TextBlock Text="This applies to all profiles."
                                       Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Integrations &amp; data">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="8">
                    <StackPanel>
                    <TextBlock Text="OPTIONAL QUIZ SOURCES" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}"/>
                    <CheckBox x:Name="EnableSpotifyCheck" Content="Enable Spotify playlist quizzes"
                              Margin="0,8,0,6" Checked="OnSpotifyFeatureChanged" Unchecked="OnSpotifyFeatureChanged"/>
                    <StackPanel x:Name="SpotifySettingsPanel" Visibility="Collapsed" Margin="0,0,0,10">
                        <TextBlock Text="Spotify Client ID" FontWeight="SemiBold" Margin="0,4"/>
                        <TextBox x:Name="SpotifyClientIdText" Height="30" VerticalContentAlignment="Center"/>
                        <TextBlock Text="Register this redirect URI in your Spotify developer app: http://127.0.0.1:5543/callback"
                                   Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,5,0,8"/>
                        <WrapPanel>
                            <Button Content="Connect Spotify…" Padding="12,6" Click="OnConnectSpotifyClick"/>
                            <Button Content="Disconnect" Padding="12,6" Margin="6,0,0,0" Click="OnDisconnectSpotifyClick"/>
                            <TextBlock x:Name="SpotifyConnectionStatus" VerticalAlignment="Center" Margin="10,0"
                                       Foreground="{DynamicResource MutedTextBrush}"/>
                        </WrapPanel>
                    </StackPanel>
                    <TextBlock Text="DEFAULT METADATA LOOKUP PROVIDER" FontSize="12" FontWeight="Bold"
                               Foreground="{DynamicResource MutedTextBrush}" Margin="0,18,0,5"/>
                    <ComboBox x:Name="ProviderCombo" Width="220" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="PathsText" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,18,0,8"/>
                    <WrapPanel Margin="0,0,0,8">
                        <Button Content="Clear Quiz History…" Height="36" Padding="14,8"
                                VerticalContentAlignment="Center" Click="OnClearHistoryClick"/>
                    </WrapPanel>
                    </StackPanel>
                </Border>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1,1,1,0"
                Padding="12,8">
            <DockPanel>
                <Button Content="Save Settings" Style="{StaticResource ActionButton}" Height="36"
                        DockPanel.Dock="Right" MinWidth="130" Padding="14,8"
                        VerticalContentAlignment="Center" Click="OnSaveClick"/>
                <WrapPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="Created by Doug Quimby" FontSize="10"
                               Foreground="{DynamicResource FooterTextBrush}" Margin="0,0,12,0"/>
                    <TextBlock x:Name="BuildInfoText" FontSize="10" Foreground="{DynamicResource FooterTextBrush}"/>
                </WrapPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
