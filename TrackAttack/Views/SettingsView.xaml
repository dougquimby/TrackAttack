<UserControl x:Class="TrackAttack.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource PageTitle}"/>
            <Border Background="White" BorderBrush="#E0E5EC" BorderThickness="1" CornerRadius="6" Padding="18">
                <StackPanel>
                    <TextBlock Text="Music library" FontSize="18" FontWeight="SemiBold"/>
                    <DockPanel Margin="0,10,0,20">
                        <Button Content="Browse…" Click="OnBrowseClick" DockPanel.Dock="Right" Margin="8,0"/>
                        <TextBox x:Name="FolderText" Height="32" VerticalContentAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="Default quiz behavior" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <WrapPanel>
                        <StackPanel Margin="0,0,18,8"><TextBlock Text="Seconds per song"/><TextBox x:Name="SecondsText" Width="120"/></StackPanel>
                        <StackPanel Margin="0,0,18,8"><TextBlock Text="Clip duration (sec)"/><TextBox x:Name="ClipDurationText" Width="120"/></StackPanel>
                    </WrapPanel>
                    <CheckBox x:Name="FuzzyArtistCheck" Content="Allow fuzzy artist matching" Margin="0,4"/>
                    <CheckBox x:Name="FuzzyTitleCheck" Content="Allow fuzzy song-title matching" Margin="0,4"/>
                    <CheckBox x:Name="IgnorePunctuationCheck" Content="Ignore punctuation when matching" Margin="0,4"/>
                    <CheckBox x:Name="SkipCorrectCheck" Content="Advance immediately after a correct guess" Margin="0,4"/>
                    <CheckBox x:Name="ShowCountsCheck" Content="Show track counts in genre and decade filters" Margin="0,4"/>
                    <TextBlock Text="Default metadata lookup provider" FontWeight="SemiBold" Margin="0,18,0,5"/>
                    <ComboBox x:Name="ProviderCombo" Width="220" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="PathsText" Foreground="#65738A" TextWrapping="Wrap" Margin="0,18,0,8"/>
                    <WrapPanel>
                        <Button Content="Save Settings" Style="{StaticResource ActionButton}" Height="36"
                                VerticalContentAlignment="Center" Click="OnSaveClick"/>
                        <Button Content="Clear Quiz History…" Height="36" Margin="4"
                                Padding="14,8" VerticalContentAlignment="Center" Click="OnClearHistoryClick"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
