<UserControl x:Class="TrackAttack.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                <Border Background="White" BorderBrush="#DCE4EF" BorderThickness="1" CornerRadius="8" Padding="22">
                    <StackPanel>
                    <TextBlock Text="QUIZ PROFILES" FontSize="12" FontWeight="Bold" Foreground="#65738A"/>
                    <ComboBox x:Name="ProfileCombo" Height="32" Margin="0,8,0,6"
                              DisplayMemberPath="Name" SelectionChanged="OnProfileSelectionChanged"/>
                    <DockPanel Margin="0,0,0,18">
                        <TextBox x:Name="ProfileNameText" Height="32" Width="220"
                                 VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                        <Button Content="Add" Padding="12,5" Margin="0,0,6,0" Click="OnAddProfileClick"/>
                        <Button Content="Rename" Padding="12,5" Margin="0,0,6,0" Click="OnRenameProfileClick"/>
                        <Button Content="Delete" Padding="12,5" Click="OnDeleteProfileClick"/>
                    </DockPanel>
                    <TextBlock Text="MUSIC LIBRARY" FontSize="12" FontWeight="Bold" Foreground="#65738A"/>
                    <DockPanel Margin="0,10,0,20">
                        <Button Content="Browse…" Click="OnBrowseClick" DockPanel.Dock="Right" Margin="8,0"/>
                        <TextBox x:Name="FolderText" Height="32" VerticalContentAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="DEFAULT QUIZ BEHAVIOR" FontSize="12" FontWeight="Bold"
                               Foreground="#65738A" Margin="0,0,0,10"/>
                    <WrapPanel>
                        <StackPanel Margin="0,0,18,8"><TextBlock Text="Seconds per song"/><TextBox x:Name="SecondsText" Width="120"/></StackPanel>
                        <StackPanel Margin="0,0,18,8"><TextBlock Text="Clip duration (sec)"/><TextBox x:Name="ClipDurationText" Width="120"/></StackPanel>
                    </WrapPanel>
                    <StackPanel Margin="0,4,0,8">
                        <TextBlock Text="Default audio volume"/>
                        <DockPanel LastChildFill="False" Margin="0,2,0,0">
                            <TextBlock x:Name="AudioVolumeValueText" DockPanel.Dock="Right"
                                       Width="42" TextAlignment="Right" VerticalAlignment="Center"
                                       Foreground="#65738A"/>
                            <Slider x:Name="AudioVolumeSlider" Minimum="0" Maximum="1"
                                    SmallChange="0.01" LargeChange="0.1" Value="1"
                                    Width="240" IsMoveToPointEnabled="True"
                                    ValueChanged="OnAudioVolumeChanged"/>
                        </DockPanel>
                    </StackPanel>
                    <CheckBox x:Name="FuzzyArtistCheck" Content="Allow fuzzy artist matching" Margin="0,4"/>
                    <CheckBox x:Name="FuzzyTitleCheck" Content="Allow fuzzy song-title matching" Margin="0,4"/>
                    <CheckBox x:Name="IgnorePunctuationCheck" Content="Ignore punctuation when matching" Margin="0,4"/>
                    <CheckBox x:Name="SkipCorrectCheck" Content="Advance immediately after a correct guess" Margin="0,4"/>
                    <CheckBox x:Name="ShowCountsCheck" Content="Show track counts in genre and decade filters" Margin="0,4"/>
                    <Separator Margin="0,16,0,12"/>
                    <TextBlock Text="OPTIONAL QUIZ SOURCES" FontSize="12" FontWeight="Bold" Foreground="#65738A"/>
                    <CheckBox x:Name="EnableSpotifyCheck" Content="Enable Spotify playlist quizzes"
                              Margin="0,8,0,6" Checked="OnSpotifyFeatureChanged" Unchecked="OnSpotifyFeatureChanged"/>
                    <StackPanel x:Name="SpotifySettingsPanel" Visibility="Collapsed" Margin="0,0,0,10">
                        <TextBlock Text="Spotify Client ID" FontWeight="SemiBold" Margin="0,4"/>
                        <TextBox x:Name="SpotifyClientIdText" Height="30" VerticalContentAlignment="Center"/>
                        <TextBlock Text="Register this redirect URI in your Spotify developer app: http://127.0.0.1:5543/callback"
                                   Foreground="#65738A" TextWrapping="Wrap" Margin="0,5,0,8"/>
                        <WrapPanel>
                            <Button Content="Connect Spotify…" Padding="12,6" Click="OnConnectSpotifyClick"/>
                            <Button Content="Disconnect" Padding="12,6" Margin="6,0,0,0" Click="OnDisconnectSpotifyClick"/>
                            <TextBlock x:Name="SpotifyConnectionStatus" VerticalAlignment="Center" Margin="10,0"
                                       Foreground="#65738A"/>
                        </WrapPanel>
                    </StackPanel>
                    <TextBlock Text="DEFAULT METADATA LOOKUP PROVIDER" FontSize="12" FontWeight="Bold"
                               Foreground="#65738A" Margin="0,18,0,5"/>
                    <ComboBox x:Name="ProviderCombo" Width="220" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="PathsText" Foreground="#65738A" TextWrapping="Wrap" Margin="0,18,0,8"/>
                    <WrapPanel Margin="0,0,0,8">
                        <Button Content="Clear Quiz History…" Height="36" Padding="14,8"
                                VerticalContentAlignment="Center" Click="OnClearHistoryClick"/>
                    </WrapPanel>
                    </StackPanel>
                </Border>
                <TextBlock Text="Created by Doug Quimby · 2026" FontSize="10" Foreground="#9AA5B4"
                           HorizontalAlignment="Center" Margin="0,10,0,4"/>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" Background="White" BorderBrush="#DCE4EF" BorderThickness="1,1,1,0"
                Padding="12,8">
            <Button Content="Save Settings" Style="{StaticResource ActionButton}" Height="36"
                    MinWidth="130" Padding="14,8" HorizontalAlignment="Right"
                    VerticalContentAlignment="Center" Click="OnSaveClick"/>
        </Border>
    </Grid>
</UserControl>
