<UserControl x:Class="TrackAttack.Views.ResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel>
            <Button Content="Play Again" DockPanel.Dock="Right" Style="{StaticResource ActionButton}"
                    MinWidth="130" Click="OnPlayAgainClick"/>
            <TextBlock x:Name="TitleText" Text="Quiz complete" Style="{StaticResource PageTitle}"/>
        </DockPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="#E0E5EC" BorderThickness="1"
                CornerRadius="6" Padding="16" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ScoreText" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"
                           Margin="0,0,24,0"/>
                <TextBlock x:Name="PercentText" Grid.Column="1" FontSize="24" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,0,28,0"/>
                <TextBlock x:Name="PerformanceMessageText" Grid.Column="2" FontSize="21" FontWeight="Bold"
                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"/>
                <TextBlock x:Name="DurationText" Grid.Column="3" FontSize="14" VerticalAlignment="Center"
                           Foreground="#65738A" TextAlignment="Right"/>
            </Grid>
        </Border>
        <TextBlock Grid.Row="2" Text="Song-by-song results" FontSize="17" FontWeight="SemiBold"
                   Foreground="#253248" Margin="0,0,0,8"/>
        <DataGrid x:Name="ResultsGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Status}" Value="Correct">
                            <Setter Property="Background" Value="#C6EFCE"/>
                            <Setter Property="Foreground" Value="#006100"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Partial">
                            <Setter Property="Background" Value="#FFEB96"/>
                            <Setter Property="Foreground" Value="#644600"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Missed">
                            <Setter Property="Background" Value="#FFC7CE"/>
                            <Setter Property="Foreground" Value="#9C0006"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="45"/>
                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="Artist" Binding="{Binding Artist}" Width="*"/>
                <DataGridTextColumn Header="Your title guess" Binding="{Binding Guess}" Width="*"/>
                <DataGridTextColumn Header="Artist guess" Binding="{Binding ArtistGuess}" Width="*"/>
                <DataGridTextColumn Header="Points" Binding="{Binding Points}" Width="70"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
